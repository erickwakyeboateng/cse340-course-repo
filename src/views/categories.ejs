<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Explore different ways to support communities and make a difference.</p>

        <section class="category-list" aria-label="Service project categories">

            <% categories.forEach(category=> { %>

                <article class="category-item">
                    <h3>
                        <%= category.name %>
                    </h3>
                    <p>
                        <%= category.description %>
                    </p>
                </article>

                <% }); %>

        </section>
    </main>

    <%- include('partials/footer') %>