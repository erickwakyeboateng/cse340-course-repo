<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Explore different ways to support communities and make a difference.</p>

        <p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-category">Add New Category</a>
                <% } %>
        </p>

        <section class="category-list" aria-label="Service project categories">

            <% categories.forEach(category=> { %>
                <article class="category-item">
                    <h3>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </h3>

                    <p>
                        <%= category.description %>
                    </p>
                </article>
                <% }); %>

        </section>
    </main>

    <%- include('partials/footer') %>