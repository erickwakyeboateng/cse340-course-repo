<%- include('partials/header') %>

    <main class="dashboard-page">
        <h1>
            <%= title %>
        </h1>

        <section class="dashboard-welcome">
            <div class="dashboard-welcome-content">
                <h2>Welcome to your Dashboard</h2>
                <p>Manage your account and explore the CSE 340 Service Network.</p>
            </div>
        </section>

        <section class="dashboard-profile">
            <h2>Account Information</h2>

            <div class="profile-information">
                <div class="profile-item">
                    <span class="profile-label">Name</span>
                    <span class="profile-value">
                        <%= name || "Not available" %>
                    </span>
                </div>

                <div class="profile-item">
                    <span class="profile-label">Email</span>
                    <span class="profile-value">
                        <%= email %>
                    </span>
                </div>
            </div>
        </section>

        <% if (user && user.role_name==='admin' ) { %>
            <section class="dashboard-admin">
                <div class="admin-card-content">
                    <div>
                        <h2>Administration</h2>
                        <p>Manage registered users and view their assigned roles.</p>
                    </div>

                    <a href="/users" class="admin-action-link">
                        View Registered Users
                        <span aria-hidden="true">&rarr;</span>
                    </a>
                </div>
            </section>
            <% } %>

    </main>

    <%- include('partials/footer') %>