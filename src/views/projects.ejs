<%- include("./partials/header") %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <ul class="project-list">
            <% projects.forEach(project=> { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong>
                            <%= project.title %>
                        </strong>
                    </a>

                    (
                    <a href="/organization/<%= project.organization_id %>">
                        <%= project.organization_name %>
                    </a>
                    )

                    <a href="/project/<%= project.project_id %>/assign-categories">
                        Edit Categories
                    </a>
                </li>
                <% }); %>
        </ul>

        <p>
            <a href="/new-project">Add a New Service Project</a>
        </p>
    </main>

    <%- include("./partials/footer") %>